{
  "name": "usage-metering-quota-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript service for account and user usage metering and quota enforcement.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "db:check": "node --env-file-if-exists=.env dist/src/db/check-connection.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx src/db/initialize.ts",
    "account:create": "node --env-file-if-exists=.env --import tsx scripts/create-account.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --passWithNoTests",
    "test:watch": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
