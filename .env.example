NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Host ports for the local demonstration stack, not production credentials/setup.
API_PORT=3000
# Keep this published port and the port in DATABASE_URL in sync.
POSTGRES_PORT=55432
DATABASE_URL=postgres://usage_metering:usage_metering_dev@localhost:55432/usage_metering
# Shared by local commands and Compose api/init/demo. Set once before issuing keys;
# changing this value invalidates keys issued with the previous pepper.
API_KEY_PEPPER=replace-with-a-long-random-value
